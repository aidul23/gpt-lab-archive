# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: use a hash instead of plaintext ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=
FLASK_DEBUG=0
FLASK_PORT=5001

# Tier 3: exact-name arXiv search (au:"Full Name") → review queue only
ARXIV_NAME_CANDIDATES_ENABLED=1
ARXIV_NAME_CANDIDATE_MAX_RESULTS=50
TIER3_SCORE_THRESHOLD=0.7
# Optional: extra coauthor names for Tier 3 scoring (comma-separated)
# LAB_KNOWN_COAUTHOR_NAMES=Pekka Abrahamsson,Muhammad Waseem
